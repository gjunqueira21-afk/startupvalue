# Copy to .env for local Compose only. Replace every CHANGE_ME value.
DOMAIN=:80
HTTP_PORT=8080
HTTPS_PORT=8443
APP_ENV=development
MODEL_VERSION=3.1.0-dev
TAX_VERSION=br-simplified-2026.09-draft

POSTGRES_DB=startupvalue
POSTGRES_USER=startupvalue
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_DATABASE_PASSWORD
REDIS_PASSWORD=CHANGE_ME_LOCAL_REDIS_PASSWORD

SESSION_SECRET=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_BYTES
CSRF_SECRET=CHANGE_ME_WITH_AT_LEAST_32_DIFFERENT_RANDOM_BYTES
SENTRY_DSN=
NEXT_PUBLIC_API_URL=http://localhost:8000

# DATABASE_URL and REDIS_URL are composed inside Docker Compose from the
# variables above. For direct backend development outside Compose, set local
# uncommitted DATABASE_URL and REDIS_URL values in your shell.
