# Store the real file outside Git with mode 600, for example /opt/startupvalue/secrets/production.env.
DOMAIN=startupvalue.com.br
ACME_EMAIL=operations@example.com
HTTP_PORT=80
HTTPS_PORT=443
APP_ENV=production
MODEL_VERSION=3.0.0
TAX_VERSION=br-simplified-2026.09
POSTGRES_DB=startupvalue
POSTGRES_USER=startupvalue_app
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_VALUE
REDIS_PASSWORD=CHANGE_ME_LONG_RANDOM_VALUE
SESSION_SECRET=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_BYTES
CSRF_SECRET=CHANGE_ME_WITH_AT_LEAST_32_DIFFERENT_RANDOM_BYTES
SENTRY_DSN=

# Use immutable tags or digests produced by CI. Never use latest.
FRONTEND_IMAGE=registry.example.com/startupvalue/frontend:CHANGE_ME_RELEASE
BACKEND_IMAGE=registry.example.com/startupvalue/backend:CHANGE_ME_RELEASE
